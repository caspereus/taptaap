      {
        "comment": "",
        "key": "Welcome to Taptaap",
        "location": {
          "startingColumn": 18,
          "startingLine": 37
        }
      },
      {
        "comment": "",
        "key": "Mechanical keyboard sounds for every key you press.",
        "location": {
          "startingColumn": 18,
          "startingLine": 40
        }
      },
      {
        "comment": "",
        "key": "Taptaap only reads virtual key codes to play sounds. It never captures, stores, or transmits what you type.",
        "location": {
          "startingColumn": 22,
          "startingLine": 58
        }
      },
      {
        "comment": "",
        "key": "Your privacy",
