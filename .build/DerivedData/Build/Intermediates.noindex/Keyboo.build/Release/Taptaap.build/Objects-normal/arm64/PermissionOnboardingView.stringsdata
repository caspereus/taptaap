          "startingColumn": 23,
          "startingLine": 55
        }
      },
      {
        "comment": "",
        "key": "Taptaap needs this permission to detect key presses system-wide and play switch sounds.",
        "location": {
          "startingColumn": 18,
          "startingLine": 78
        }
      },
